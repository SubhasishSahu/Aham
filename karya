<script>
// ── SKILLS ──
const skills = [
  { name: "SAP BusinessObjects", pct: 98 },
  { name: "SAP BW/4HANA", pct: 96 },
  { name: "SAP Analytics Cloud", pct: 88 },
  { name: "SAP Lumira Designer", pct: 90 },
  { name: "Data Modelling", pct: 95 },
  { name: "SQL / HANA Views", pct: 85 },
  { name: "Solution Architecture", pct: 88 },
  { name: "Project Management", pct: 85 },
  { name: "Power BI / MS BI", pct: 75 },
  { name: "Financial Analytics", pct: 82 },
];

const sg = document.getElementById('skillsGrid');
skills.forEach(s => {
  const row = document.createElement('div');
  row.className = 'skill-row';
  row.innerHTML = `
    <div class="skill-name">
      <span>${s.name}</span>
      <span class="skill-pct">${s.pct}%</span>
    </div>
    <div class="skill-bar">
      <div class="skill-fill" data-pct="${s.pct}"></div>
    </div>`;
  sg.appendChild(row);
});

// ── DONUTS ──
const domains = [
  { label: "Insurance", years: 2, color: "#E85C0D" },
  { label: "Pharma", years: 2, color: "#C94F0B" },
  { label: "Airlines &\nAutomotive", years: 4, color: "#FF7A33" },
  { label: "FMCG", years: 4, color: "#FFB085" },
  { label: "Utility &\nLife Science", years: 4, color: "#FFC49A" },
  { label: "Telecom &\nOther", years: 3, color: "#FFD8BF" },
];

const totalYears = 19;
const dr = document.getElementById('donutsRow');
domains.forEach(d => {
  const circ = 2 * Math.PI * 16;
  const fill = (d.years / totalYears) * 100;
  const wrap = document.createElement('div');
  wrap.className = 'donut-wrap';
  wrap.innerHTML = `
    <div class="donut-years">${d.years}y</div>
    <svg class="donut-svg" width="54" height="54" viewBox="0 0 36 36">
      <circle class="donut-bg" cx="18" cy="18" r="16"/>
      <circle class="donut-ring" cx="18" cy="18" r="16" stroke="${d.color}"
        data-fill="${fill}" stroke-dashoffset="0"/>
    </svg>
    <div class="donut-label">${d.label.replace('\n','<br>')}</div>`;
  dr.appendChild(wrap);
});

// ── ANIMATE ON LOAD ──
window.addEventListener('load', () => {
  // Skill bars
  setTimeout(() => {
    document.querySelectorAll('.skill-fill').forEach(el => {
      el.style.width = el.dataset.pct + '%';
    });
  }, 300);

  // Donut rings
  setTimeout(() => {
    document.querySelectorAll('.donut-ring').forEach(el => {
      const fill = parseFloat(el.dataset.fill);
      const circ = 2 * Math.PI * 16;
      const dash = (fill / 100) * circ;
      el.style.strokeDasharray = `${dash} ${circ}`;
    });
  }, 400);
});
</script>

</body>
</html>