<style>
  :root {
    --orange: #E85C0D;
    --orange-light: #FF7A33;
    --orange-pale: #FFF0E8;
    --dark: #1A1009;
    --mid: #4A3728;
    --gray: #8A7A6E;
    --light: #F9F4F0;
    --white: #FFFFFF;
    --accent: #1B3A5C;
  }

- { margin: 0; padding: 0; box-sizing: border-box; }

body {
font-family: ‘DM Sans’, sans-serif;
background: var(–light);
color: var(–dark);
min-height: 100vh;
}

/* ── HERO ── */
.hero {
background: var(–dark);
padding: 60px 64px 52px;
display: grid;
grid-template-columns: 1fr auto;
gap: 40px;
align-items: end;
}

.hero-name {
font-family: ‘DM Serif Display’, serif;
font-size: clamp(40px, 5vw, 68px);
color: var(–white);
line-height: 1.0;
letter-spacing: -1px;
}

.hero-name span { color: var(–orange); }

.hero-title {
font-size: 15px;
font-weight: 500;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–gray);
margin-top: 12px;
}

.hero-contact {
display: flex;
gap: 24px;
margin-top: 20px;
flex-wrap: wrap;
}

.hero-contact a, .hero-contact span {
color: var(–gray);
font-size: 13px;
text-decoration: none;
display: flex;
align-items: center;
gap: 6px;
transition: color .2s;
}

.hero-contact a:hover { color: var(–orange); }

.hero-stats {
display: flex;
flex-direction: column;
gap: 16px;
align-items: flex-end;
}

.stat-pill {
background: rgba(232,92,13,0.15);
border: 1px solid rgba(232,92,13,0.3);
border-radius: 40px;
padding: 10px 22px;
text-align: center;
}

.stat-pill .num {
font-family: ‘DM Serif Display’, serif;
font-size: 32px;
color: var(–orange);
line-height: 1;
}

.stat-pill .label {
font-size: 10px;
text-transform: uppercase;
letter-spacing: 2px;
color: var(–gray);
margin-top: 2px;
}

/* ── LAYOUT ── */
.page {
max-width: 1200px;
margin: 0 auto;
padding: 48px 48px;
}

.grid-2 {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 32px;
margin-bottom: 32px;
}

.grid-3 {
display: grid;
grid-template-columns: 1fr 1fr 1fr;
gap: 32px;
margin-bottom: 32px;
}

/* ── CARDS ── */
.card {
background: var(–white);
border-radius: 16px;
padding: 32px;
position: relative;
overflow: hidden;
box-shadow: 0 2px 24px rgba(26,16,9,0.06);
}

.card-full { grid-column: 1 / -1; }

.card-label {
font-size: 10px;
font-weight: 600;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–orange);
margin-bottom: 20px;
}

.card-title {
font-family: ‘DM Serif Display’, serif;
font-size: 22px;
color: var(–dark);
margin-bottom: 24px;
}

/* ── TIMELINE ── */
.timeline {
position: relative;
padding-left: 28px;
}

.timeline::before {
content: ‘’;
position: absolute;
left: 8px;
top: 8px;
bottom: 8px;
width: 2px;
background: linear-gradient(to bottom, var(–orange) 0%, rgba(232,92,13,0.1) 100%);
}

.tl-item {
position: relative;
margin-bottom: 28px;
animation: fadeInLeft .5s ease both;
}

.tl-item:nth-child(1) { animation-delay: .1s; }
.tl-item:nth-child(2) { animation-delay: .2s; }
.tl-item:nth-child(3) { animation-delay: .3s; }
.tl-item:nth-child(4) { animation-delay: .4s; }
.tl-item:nth-child(5) { animation-delay: .5s; }
.tl-item:nth-child(6) { animation-delay: .6s; }

.tl-dot {
position: absolute;
left: -24px;
top: 5px;
width: 14px;
height: 14px;
border-radius: 50%;
background: var(–white);
border: 2.5px solid var(–orange);
z-index: 1;
transition: transform .2s;
}

.tl-item.current .tl-dot {
background: var(–orange);
box-shadow: 0 0 0 4px rgba(232,92,13,0.2);
}

.tl-item:hover .tl-dot { transform: scale(1.3); }

.tl-period {
font-size: 10px;
font-weight: 600;
letter-spacing: 2px;
text-transform: uppercase;
color: var(–orange);
margin-bottom: 3px;
}

.tl-role {
font-weight: 600;
font-size: 14px;
color: var(–dark);
line-height: 1.3;
}

.tl-company {
font-size: 12px;
color: var(–gray);
margin-top: 2px;
}

.tl-tag {
display: inline-block;
background: var(–orange-pale);
color: var(–orange);
font-size: 10px;
font-weight: 600;
padding: 2px 8px;
border-radius: 20px;
margin-top: 5px;
}

/* ── SKILLS RADAR ── */
.skills-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 14px;
}

.skill-row {
display: flex;
flex-direction: column;
gap: 5px;
}

.skill-name {
display: flex;
justify-content: space-between;
font-size: 12px;
font-weight: 500;
color: var(–mid);
}

.skill-pct { color: var(–orange); font-weight: 600; }

.skill-bar {
height: 6px;
background: var(–orange-pale);
border-radius: 10px;
overflow: hidden;
}

.skill-fill {
height: 100%;
background: linear-gradient(90deg, var(–orange), var(–orange-light));
border-radius: 10px;
width: 0%;
transition: width 1.2s cubic-bezier(.22,1,.36,1);
}

/* ── DOMAIN DONUTS ── */
.donuts-row {
display: flex;
justify-content: space-around;
align-items: center;
gap: 16px;
flex-wrap: wrap;
}

.donut-wrap {
display: flex;
flex-direction: column;
align-items: center;
gap: 8px;
flex: 1;
min-width: 90px;
}

.donut-svg { transform: rotate(-90deg); }

.donut-bg { fill: none; stroke: var(–orange-pale); stroke-width: 7; }

.donut-ring {
fill: none;
stroke-width: 7;
stroke-linecap: round;
stroke-dasharray: 0 100;
transition: stroke-dasharray 1.4s cubic-bezier(.22,1,.36,1);
}

.donut-label {
font-size: 11px;
font-weight: 600;
color: var(–mid);
text-align: center;
line-height: 1.3;
}

.donut-years {
font-family: ‘DM Serif Display’, serif;
font-size: 20px;
color: var(–dark);
text-align: center;
line-height: 1;
}

/* ── GLOBE / LOCATIONS ── */
.locations-grid {
display: grid;
grid-template-columns: repeat(4, 1fr);
gap: 16px;
}

.location-card {
background: var(–light);
border-radius: 12px;
padding: 18px 16px;
text-align: center;
border: 1px solid transparent;
transition: border-color .2s, transform .2s;
cursor: default;
}

.location-card:hover {
border-color: var(–orange);
transform: translateY(-3px);
}

.location-flag {
font-size: 32px;
margin-bottom: 8px;
display: block;
}

.location-name {
font-size: 13px;
font-weight: 600;
color: var(–dark);
}

.location-role {
font-size: 11px;
color: var(–gray);
margin-top: 3px;
line-height: 1.4;
}

/* ── CERT CHIPS ── */
.certs-flow {
display: flex;
flex-wrap: wrap;
gap: 10px;
}

.cert-chip {
display: flex;
align-items: center;
gap: 8px;
background: var(–light);
border: 1px solid rgba(232,92,13,0.2);
border-radius: 40px;
padding: 8px 16px;
transition: background .2s, border-color .2s;
}

.cert-chip:hover {
background: var(–orange-pale);
border-color: var(–orange);
}

.cert-icon {
width: 24px;
height: 24px;
border-radius: 50%;
background: var(–orange);
display: flex;
align-items: center;
justify-content: center;
font-size: 11px;
color: white;
font-weight: 700;
flex-shrink: 0;
}

.cert-text { font-size: 12px; font-weight: 500; color: var(–mid); }
.cert-year { font-size: 10px; color: var(–gray); }

/* ── HIGHLIGHT NUMBERS ── */
.highlights {
display: flex;
gap: 0;
}

.hl-item {
flex: 1;
text-align: center;
padding: 20px 12px;
border-right: 1px solid var(–light);
position: relative;
}

.hl-item:last-child { border-right: none; }

.hl-num {
font-family: ‘DM Serif Display’, serif;
font-size: 40px;
color: var(–orange);
line-height: 1;
display: block;
}

.hl-label {
font-size: 11px;
font-weight: 500;
color: var(–gray);
letter-spacing: 1px;
text-transform: uppercase;
margin-top: 4px;
}

/* ── SUMMARY CARD ── */
.summary-text {
font-size: 15px;
line-height: 1.75;
color: var(–mid);
font-weight: 300;
}

.summary-text strong {
color: var(–dark);
font-weight: 600;
}

.badge-row {
display: flex;
gap: 8px;
flex-wrap: wrap;
margin-top: 20px;
}

.badge {
background: var(–dark);
color: var(–white);
font-size: 11px;
font-weight: 500;
letter-spacing: .5px;
padding: 5px 14px;
border-radius: 20px;
}

.badge.orange { background: var(–orange); }

/* ── DECOR ── */
.card-decor {
position: absolute;
top: -20px;
right: -20px;
width: 100px;
height: 100px;
border-radius: 50%;
background: radial-gradient(circle, rgba(232,92,13,0.08) 0%, transparent 70%);
pointer-events: none;
}

@keyframes fadeInLeft {
from { opacity: 0; transform: translateX(-12px); }
to { opacity: 1; transform: translateX(0); }
}

@keyframes fadeInUp {
from { opacity: 0; transform: translateY(20px); }
to { opacity: 1; transform: translateY(0); }
}

.fade-up {
animation: fadeInUp .6s ease both;
}

/* ── FOOTER ── */
.footer {
text-align: center;
padding: 24px;
font-size: 11px;
color: var(–gray);
letter-spacing: 1px;
text-transform: uppercase;
}

/* ── RESPONSIVE ── */
@media (max-width: 768px) {
.hero { grid-template-columns: 1fr; padding: 40px 28px; }
.page { padding: 28px 20px; }
.grid-2, .grid-3 { grid-template-columns: 1fr; }
.locations-grid { grid-template-columns: repeat(2, 1fr); }
.card-full { grid-column: 1; }
.highlights { flex-wrap: wrap; }
.hl-item { min-width: 45%; }
}
</style>

